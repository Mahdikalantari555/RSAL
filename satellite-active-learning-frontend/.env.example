# Local PostgreSQL connection (configured by the development environment)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Leave unset to use the persistent, explicitly simulated demo backend.
# Set this to connect a real satellite classification service:
# SATELLITE_API_URL=http://localhost:8000
# Optional server-side bearer token; never exposed to the browser.
# SATELLITE_API_TOKEN=
